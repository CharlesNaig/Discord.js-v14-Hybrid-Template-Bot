# Discord Bot Configuration Variables
# ====================================
# This file contains all required environment variables for the Discord.js v14 Hybrid Template Bot.
# Copy this file to .env and fill in your actual values.

# Bot Authentication
# TOKEN - Your Discord bot token from https://discord.com/developers/applications
# Obtain this from the Discord Developer Portal under your application's "Bot" section
TOKEN=your_bot_token

# Bot Identification
# CLIENT_ID - Your application's Client ID from the Discord Developer Portal
# Used for OAuth2 authorization and bot invitations
CLIENT_ID=your_client_id

# Guild Configuration
# GUILD_ID - Your Discord server (guild) ID for testing slash commands and guild-specific features
# Leave empty for global command registration (slower deployment)
GUILD_ID=your_guild_id

# Owner Configuration
# OWNER_ID - Your personal Discord user ID for owner-only commands and features
# Obtain your ID by enabling Developer Mode in Discord and right-clicking your profile
OWNER_ID=your_discord_id

# Database Configuration
# MONGO_URL - Your MongoDB connection string for data persistence
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
# Obtain this from your MongoDB Atlas cluster connection settings
MONGO_URL=your_mongodb_url

# Command Configuration
# PREFIX - The prefix character(s) for prefix-based commands (used in hybrid command system)
# Only applies to message-based command handling
PREFIX=!

# Environment Mode
# PRODUCTION - Set to 'true' for production environment, 'false' for development
# Controls error handling, logging verbosity, and deployment behavior
PRODUCTION=true

# Message Format Configuration
# DEFAULT_MESSAGE_TYPE - Default response format for bot messages
# Options: 'embed' (Discord embeds), 'componentsv2' (Discord components v2) or 'text' (plain text messages)
DEFAULT_MESSAGE_TYPE=embed

# Bot Links and Resources
# SUPPORT_SERVER - Invite link to your Discord support server
# Provide users with a way to get help and join your community
SUPPORT_SERVER=https://discord.gg/your_support_server_invite

# INVITE_LINK - OAuth2 authorization URL for inviting the bot to servers
# Replace your_client_id with your actual CLIENT_ID value
# Use this link to allow others to add your bot to their servers
INVITE_LINK=https://discord.com/api/oauth2/authorize?client_id=your_client_id

# WEBSITE - Your bot's official website or documentation page
# Provide information about bot features, commands, and support
WEBSITE=https://your_website_url